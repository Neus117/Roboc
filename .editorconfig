# Roboc — 编辑器与编码规则
#
# 这个仓库里最常见的两类低级故障都源于编码，所以规则写在这里而不是靠记忆。

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# ------------------------------------------------------------------ C# 源码

[*.cs]
indent_size = 4

# 换行必须显式声明。这个项目一度用 CRLF 与 LF 混排，diff 里整文件都成了改动。
csharp_new_line_before_open_brace = all

# 未使用的私有成员 = 错误。配合 Directory.Build.props 的 EnforceCodeStyleInBuild。
#
# 为什么是 error 而不是 warning：项目已经要求"构建必须是零警告"（见开发者文档
# 第七节规则 8），多一条警告本来就会被当成失败。写成 error 是为了让它在 CI 的
# -warnaserror 之外也拦得住，而且意图更明确。
#
# 为什么值得单开一条：check-wiring.ps1 查的是"声明了却无人读取的属性与参数"，
# 查不出"定义了却无人调用的私有方法"。这一类编译通过、运行无异常，只是永远
# 不执行 —— WriteMarker 与 MeasureOne 都藏了很久。
#
# 2026-10-15 一次性清掉 9 处后开启：
#   FolderShownBy（方法，被替换掉的那条路径留下的孤儿）
#   UndoCommand.Fraction（与 DeleteCommand.Fraction 重复定义）
#   GA_ROOT, WS_TABSTOP, WS_BORDER, WS_THICKFRAME, WS_MAXIMIZEBOX,
#   BS_PUSHBUTTON, CW_USEDEFAULT（未使用的 Win32 常量）
#
# ⚠️ IDE0051 在【反射、序列化、DI 容器、XAML】四类场景会误报。
# 本项目这四类都没有（P/Invoke 的 extern 声明没有方法体，不会被报），
# 所以今天安全。若将来引入插件式注册或反射加载，先回来读这一段。
dotnet_diagnostic.IDE0051.severity = error

# ------------------------------------------------------------------ 脚本

[*.ps1]
indent_size = 4

# PowerShell 5.1 对无 BOM 的 .ps1 按系统 ANSI 代码页解码，中文变乱码，
# 进而引发一串看起来像语法错误的报错（"缺少右 }"、"Try 语句缺少 Catch"）。
# 这个坑踩过两次，其中一次是编辑工具写回时丢失 BOM。
#
# 所以 .ps1 必须带 BOM —— 这一条不要改成 utf-8。
charset = utf-8-bom

[*.{json,jsonc}]
indent_size = 2

[*.{md,markdown}]
# 文档里的中文与代码块结尾的空格有意义，不裁剪
trim_trailing_whitespace = false

[*.{csproj,props,targets,sln}]
indent_size = 2

# ------------------------------------------------------------------ 二进制

[*.{ico,png,jpg,jpeg,gif,bmp}]
# 二进制文件不参与任何文本规则
insert_final_newline = false
trim_trailing_whitespace = false
