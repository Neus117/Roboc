bin/
obj/
artifacts/
publish/
.dotnet/
*.user
*.suo
.vs/
.idea/

# Benchmark scratch. These hold hundreds of thousands of files between runs;
# run-bench.ps1 cleans its scratch at the end, but a killed run does not.
scripts/corpus/
scripts/out/
scripts/scratch/
scripts/run/
scripts/results/

# 测试产物。见开发者文档「十四、测试卫生」。
artifacts/scratch/

# Python 字节码缓存。tools\ 下的脚本是构建期工具，不是产品的一部分，
# 但它们的缓存目录会出现在 git status 里，看着像待提交的新文件。
__pycache__/
*.pyc

# 运营内容：渠道评估、捐赠方案、宣传文案、逐日待办。
#
# 这些东西刻意不放在仓库里 —— 它们是盈利与推广性质的，进公开仓库不合适。
# 也不放"仓库内的忽略目录"：那样 git status 会一直是脏的，而且一次
# git add -A 就会把它收进来。实际位置在仓库外：
#     D:\Coding\DeepSeek 开发经验\运营\
# 这一条只是兜底，防止有人（包括我）又在仓库里建一个同名目录。
docs/运营/
